<!-- xmlns:tools wird fuer die Manifest-Merge-Regel gebraucht: ohne die
     ACCESS_FINE_LOCATION aus den Plugins (geolocator) zu entfernen, muss
     der Merge darueber informiert werden. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Google Play, Mikrofon: Die App nutzt RECORD_AUDIO fuer
         Sprachnachrichten und Anrufe. Vor der ersten Aufnahme zeigt
         ChatDetailScreen einen Erklaerungsdialog
         (chat.micDisclosure*); erst nach dessen Bestaetigung wird die
         Berechtigung angefragt. Ohne Mikrofon bleibt die App voll
         nutzbar (Schreiben, Tippen, Ansehen). -->
    <!-- Transit Spark (v0.9.0): BLE-Advertising/Scanning im Vordergrund -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Legacy-BT fuer Android 11 und aelter (Scan/Advertise brauchen
         dort BLUETOOTH_ADMIN + Standort; maxSdkVersion begrenzt sauber) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Benachrichtigungen (Android 13+ Runtime-Permission wird in
         NotificationService.initialize() angefragt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
<!-- Standort (einmalige, freiwillige Abfrage zur Entfernungsberechnung;
         Runtime-Permission wird beim Tippen auf "Standort erkennen" 
         angefragt - ohne diese Manifest-Eintraege erscheint NIE ein
         Systemdialog und getCurrentPosition schlaegt still fehl). -->

    <!-- NUR ungefaehrer Standort (ACCESS_COARSE_LOCATION).

         Google Play verlangt fuer ACCESS_FINE_LOCATION einen
         Kernfunktions-Nachweis. Diese App nutzt den Standort fuer genau
         zwei Dinge: die Entfernungsanzeige ("Umkreis") und die
         Standortverifikation. Beides funktioniert mit der ungefaehren
         Berechtigung - der Nutzer sieht "ungefaehr bei dir", und fuer
         die Verifikation ("Stadt bestaetigt") ist eine Genauigkeit von
         einem Kilometer nicht besser.

         Die genaue Berechtigung WIRD deshalb nicht mehr angefragt. Sie
         stand bis v0.9.2 im Manifest, ohne je angefragt zu werden, und
         taucht damit in der Vorabpruefung des Play Console als
         sensibler Berechtigungsantrag auf - ohne Nutzen fuer die App.

         Wer eine exakte Position braucht (etwa Transit Spark fuer die
         Naeheerkennung im Zug), bekommt sie nicht, weil die App sie
         nicht anfordert. Das ist Absicht: Weniger Daten, gleiche
         Funktion. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- BEGRUENDUNG fuer das Weglassen von ACCESS_FINE_LOCATION (Play
         verlangt fuer sensitive Berechtigungen eine Angabe, warum sie
         nicht genuegt):
         - Entfernungsanzeige: ungefaehr reicht, der Nutzer sieht den
           Umkreis ohne Straassennamen.
         - Standortverifikation: bestaetigt die Stadt, nicht die Adresse.
         - Transit Spark: BLE selbst liefert die Naehe, nicht GPS.
         Ein Wegfall der genaueren Berechtigung verschlechtert keinen
         dieser drei Punkte.

         `tools:node="remove"` entfernt die Berechtigung aus den
         Plugins (geolocator deklariert sie mit). Eine zweite
         FINE-Zeile mit `maxSdkVersion="0"` als Fallback wurde entfernt:
         der Manifest-Merger meldet beide Eintraege als Duplikat und
         bricht den Build ab. Eine Entfernung reicht; ob sie gegriffen
         hat, steht im Merge-Report, den Gradle mit "info" ausgiebt. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:node="remove" />

    <!-- Legacy-Speicherzugriffe aus image_picker: seit Android 13
         (API 33) gibt es diese Berechtigungen nicht mehr, und seit
         Android 10 (API 29) der Zugriff ueber das Dateisystem fuer
         fremde Bilder. Die App braucht sie nicht - Fotos laufen ueber
         den Photo Picker, bei dem keine Berechtigung noetig ist.

         Ohne diese Grenze stehen sie im fertigen Paket und tauchen in
         der Vorabpruefung des Play Console als "ungenutzte
         Berechtigung" auf. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <application
        android:label="Thestia"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:allowBackup="false">
        <!-- allowBackup=false (Audit): Das App-Verzeichnis enthaelt
             profilbezogene PII und lokale Caches; es darf weder in das
             Google-Cloud-Backup noch in Device-to-Device-Umzuege
             (d2d) gelangen. Tokens liegen zusaetzlich im Keystore. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep-Link für den Passwort-Reset (thestia://reset-password).
                 Der Link aus der Recovery-E-Mail enthält Token im Fragment/
                 Query; AppDeepLinkPlugin (supabase_flutter) verarbeitet ihn
                 und meldet das passwordRecovery-Event. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="thestia"/>
            </intent-filter>
            <!-- App Links (HTTPS, autoVerify): Sichere Variante für den
                 Recovery-Flow - nur die verifizierte Domain darf die Links
                 öffnen, fremde Apps können sie nicht abfangen. Voraussetzung:
                 https://thestia.de/.well-known/assetlinks.json muss den
                 SHA-256 des Signatur-Zertifikats enthalten (siehe
                 passkey-assets/ASSETLINKS_ROOTDOMAIN.md). Bleibt die Datei
                 unbeantwortet, fällt Android still auf thestia:// zurück. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="thestia.de"/>
            </intent-filter>
        </activity>
        <!-- image_cropper: Crop-Screen fuer Profilbilder. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <!-- Screenshot-Freigabe (nur Store-Screenshot-Builds):
             MainActivity liest diesen Wert und setzt FLAG_SECURE nur, wenn
             er "false" ist. Standard: false (Store-Releases bleiben
             screenshot-sicher). -->
        <meta-data
            android:name="allowScreenshots"
            android:value="${allowScreenshots}" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Android-11-Text-Dehnung (Geräte-Feedback): Auf betroffenen
             Android-11-Geräten rendert Impeller Glyphen inkonsistent
             (gestreckt/zu dünn, vgl. flutter/flutter#187908). Skia als
             Renderer erzwingen (dokumentierter Escape-Hatch) - Skia ist
             der bewährte Pfad; kein funktionaler Unterschied der App. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />

        <!-- Thestia-Logo (weisse Silhouette) als Small-Icon fuer FCM-Push -
             ohne diesen Eintrag zeigt Android nur einen weissen Punkt. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/notification_icon" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <!-- Passkey-/Credential-Manager-Verknüpfung mit der RP-Domain
             (auth.thestia.de). Die Datei liegt unter
             https://auth.thestia.de/.well-known/assetlinks.json.
             Ohne diesen Eintrag verweigert Android den Passkey-Dialog. -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
