# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
**/build/
**/.gradle/
**/.kotlin/
.vercel
.env*
!.env.example

# Legacy-Signaling-Server (nicht mehr in Verwendung, nur Referenz)
server/node_modules/
supabase/.temp/
supabase/.branches/

# Interne Planungs-/Audit-Dokumente (Sicherheitsdetails nicht veröffentlichen)
PLAN.md
PLAN_ERWEITERUNGEN.md
ANALYSE.md
# Rechts-/Datenschutz-Entwürfe mit Betreiber-Internas (privat halten)
docs/DATENSCHUTZ-ENTWURF.md
# Secrets & lokale Umgebungsdateien (.env*, *.env), nur .env.example ist erlaubt
.env*
*.env
!.env.example
rotate.sql

android/key.properties
# Firebase-Client-Konfiguration (API-Key, Projekt-IDs): Nur das
# redigierte Beispiel einchecken (google-services.json.example),
# echte Datei lokal aus der Firebase Console beziehen.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
*.keystore

# =============================================================================
# Weitere lokale Dateien/Ordner, die nicht ins Git gehören
# =============================================================================

# Versehentlich in den Repo-Root kopierte Projektkopie (leere Ordnerskelette)
Projekte/

# Windows-Explorer-/Systemdateien
Thumbs.db
desktop.ini

# Weitere Signing-Keys / Zertifikate (JKS, PKCS#12, PEM, ...)
*.jks
*.p12
*.pfx
*.pem
*.key
**/service-account*.json

# Verteilbare Build-Artefakte (falls sie außerhalb von build/ landen)
*.apk
*.aab
*.ipa

# Admin-APKs (mit einkompilierter ADMIN_UUID) bleiben privat - niemals
# ins oeffentliche Repository / Release hochladen.
releases/*/admin/

# Editor-/Backup-Dateien
*.bak
*.orig
*.rej

# iOS-Signing / Provisioning (Betreiber-lokal)
*.mobileprovision
*.provisionprofile

# Fastlane-Laufzeitberichte (regenerierbar)
fastlane/report.xml
fastlane/README.md

# Node-Module (generisch, falls wieder Node-Tools im Repo liegen)
node_modules/

# Screenshot-Goldens (regenerierbare Build-Artefakte, teils > 100 KB):
# Neu erzeugen mit STORE_SHOTS=1 flutter test --update-goldens test/screenshots/
test/screenshots/goldens/
# Store-Screenshot-Renderer (v0.9.1) inkl. seiner Ausgaben: sind
# Werbematerial, kein Quellcode - werden lokal via
# tool/make_store_screenshots.py erzeugt und nicht veroeffentlicht.
test/screenshots/store_v091_shots_test.dart
test/screenshots/store_v091/
fastlane/metadata/android/*/images/phoneScreenshots/
releases/testapk/screenshots/

# Plattform-Ephemeral-Ordner (Flutter-Tool, auto-generiert)
**/Flutter/ephemeral/
**/.symlinks/
**/Pods/
# Temporaere Analyse-Ausgaben
tool/*.txt
